# Telegram Bot Token (从 @BotFather 获取)
BOT_TOKEN=your_bot_token_here

# 日志级别
LOG_LEVEL=INFO

# 数据库配置
# 注意：在 Docker 环境中，数据库文件位于 /app/data 目录
DATABASE_URL=sqlite:///data/banhammer_bot.db

# 管理员用户ID列表 (用于私聊转发功能，多个ID用逗号分隔)
# 未配置时将无管理员可用
ADMIN_USER_IDS=254563965,123456789,987654321


# Cloudflare Workers AI / clef-flash（中文区入群与首条广告检测）
# 两者都配置后默认启用；设置 CLEF_ENABLED=false 可强制关闭
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# CLEF_ENABLED=true
# 取值须在 (0, 1]；非法值回退到 0.85
CLEF_AUTO_KICK_THRESHOLD=0.85
CLEF_TIMEOUT=15
